  38:../source/SYSTICK.c **** #define Kms 100000L
  39:../source/SYSTICK.c **** #define Kus 100L
  40:../source/SYSTICK.c **** #define PER_ms(x)  ((x)*Kms)
  41:../source/SYSTICK.c **** #define PER_us(x)  ((x)*Kus)
  42:../source/SYSTICK.c **** 
  43:../source/SYSTICK.c **** 
  44:../source/SYSTICK.c **** static uint32_t rti_period = PER_ms(100);  // Default Sample Rate
  45:../source/SYSTICK.c **** 
  46:../source/SYSTICK.c **** 
  47:../source/SYSTICK.c **** 
  48:../source/SYSTICK.c **** // Max Reload value 2^24-1= 167.772.160 => 167.772.160 x 10ns = 1.677.721.600 ns
  49:../source/SYSTICK.c **** //                                                            = 1,677.721.600 seg
  50:../source/SYSTICK.c **** 
  51:../source/SYSTICK.c **** void SysTick_Init (void)
  52:../source/SYSTICK.c **** {
  53:../source/SYSTICK.c **** 	SysTick->CTRL = 0x00;
  54:../source/SYSTICK.c **** //	SysTick->LOAD = 12500000L-1;  //12499999L; // <= 125 ms @ 100Mhz - 10ns
  55:../source/SYSTICK.c **** 	SysTick->LOAD = rti_period-1;
  56:../source/SYSTICK.c **** 
  57:../source/SYSTICK.c **** 	SysTick->VAL  = 0x00;
  58:../source/SYSTICK.c **** 	SysTick->CTRL = SysTick_CTRL_CLKSOURCE_Msk | SysTick_CTRL_TICKINT_Msk | SysTick_CTRL_ENABLE_Msk;
  59:../source/SYSTICK.c **** }
  60:../source/SYSTICK.c **** 
